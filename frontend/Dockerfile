# 1. Използваме официален лек Node.js имидж
FROM node:20-alpine

# 2. Задаваме работната директория вътре в контейнера
WORKDIR /app

# 3. Копираме файловете, описващи пакетите
COPY package*.json ./

# 4. Инсталираме зависимостите
RUN npm install

# 5. Копираме останалата част от кода на проекта
COPY . .

# 6. Отваряме порта, на който работи Vite
EXPOSE 5173

# 7. Стартираме Vite в режим на разработка
CMD ["npm", "run", "dev"]
